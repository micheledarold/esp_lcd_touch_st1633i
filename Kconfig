menu "ST1633i Touch Screen Configuration"

    config ESP_LCD_TOUCH_ST1633I_I2C_ADDRESS
        hex "ST1633i I2C Address"
        default 0x55
        help
            L'indirizzo I2C standard dell'ST1633i è solitamente 0x55 (7-bit).

    # Lo swap/mirror degli assi si configura a runtime tramite i flag standard
    # esp_lcd_touch_config_t.flags (swap_xy / mirror_x / mirror_y), non più via Kconfig.

endmenu